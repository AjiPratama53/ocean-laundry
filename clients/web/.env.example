# Local API + local Keycloak:
# VITE_API_BASE_URL=http://localhost:3000
# VITE_OIDC_ISSUER=http://localhost:8081/realms/ocean-laundry
# VITE_OIDC_TOKEN_URL=http://localhost:8081/realms/ocean-laundry/protocol/openid-connect/token
#
# Local API + Railway-hosted Keycloak:
VITE_API_BASE_URL=http://localhost:3000
VITE_OIDC_ISSUER=https://<keycloak-domain>/realms/ocean-laundry
VITE_OIDC_TOKEN_URL=https://<keycloak-domain>/realms/ocean-laundry/protocol/openid-connect/token
VITE_OIDC_CLIENT_ID=test-cli
VITE_POLL_INTERVAL_MS=5000
