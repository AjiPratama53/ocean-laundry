KC_ADMIN_PASSWORD=your-admin-password-here

# --- Vercel `auth` service (infra/Dockerfile.vercel) — set in Vercel Dashboard ---
# Keycloak admin (bootstrap, Keycloak 26 uses KC_BOOTSTRAP_*):
# KC_BOOTSTRAP_ADMIN_USERNAME=admin
# KC_BOOTSTRAP_ADMIN_PASSWORD=<generate-a-secret>
#
# External Postgres (REQUIRED on Vercel — Functions are stateless, H2 loses data):
# KC_DB=postgres
# KC_DB_URL=jdbc:postgresql://<host>:5432/<db>
# KC_DB_USERNAME=<db-user>
# KC_DB_PASSWORD=<db-password>
#
# Public URL handling (single-domain routing via /auth):
# KC_HOSTNAME=https://<your-app>.vercel.app
# KC_HOSTNAME_STRICT=false
# KC_PROXY_HEADERS=xforwarded
# (KC_HTTP_RELATIVE_PATH=/auth is already baked into Dockerfile.vercel)