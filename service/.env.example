DATABASE_URL=your-database-url-here
PORT=your-port-here
LOG_LEVEL=info

# Local Keycloak:
# OIDC_ISSUER=http://localhost:8081/realms/ocean-laundry
# OIDC_JWKS_URI=http://localhost:8081/realms/ocean-laundry/protocol/openid-connect/certs
#
# Railway-hosted Keycloak:
# OIDC_ISSUER=https://<keycloak-domain>/realms/ocean-laundry
# OIDC_JWKS_URI=https://<keycloak-domain>/realms/ocean-laundry/protocol/openid-connect/certs
OIDC_ISSUER=your-oidc-issuer-here
OIDC_JWKS_URI=your-oidc-jwks-uri-here
OIDC_AUDIENCE=ocean-laundry-api

# Explicit CORS allowlist, comma-separated (A.4.4). Never reflected.
# Example: CORS_ALLOWED_ORIGINS=https://ocean.example,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173