DATABASE_URL=your-database-url-here
PORT=your-port-here
LOG_LEVEL=info

OIDC_ISSUER=your-oidc-issuer-here
OIDC_JWKS_URI=your-oidc-jwks-uri-here
OIDC_AUDIENCE=your-oidc-audience-here

# Explicit CORS allowlist, comma-separated (A.4.4). Never reflected.
# Example: CORS_ALLOWED_ORIGINS=https://ocean.example,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173